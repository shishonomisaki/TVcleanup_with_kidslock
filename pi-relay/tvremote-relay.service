# systemd user unit for the relay. Copy to ~/.config/systemd/user/, fill in the two addresses, then:
#   systemctl --user daemon-reload && systemctl --user enable --now tvremote-relay
#   sudo loginctl enable-linger $USER      (start at boot without a login)
[Unit]
Description=TV remote relay for Parental Lock
After=network-online.target

[Service]
WorkingDirectory=%h/tvremote
Environment=RELAY_BIND=<this machine's LAN address>
Environment=RELAY_TV=<the TV's LAN address>
Environment=RELAY_PORT=6480
ExecStart=%h/tvremote/venv/bin/python %h/tvremote/relay.py
Restart=always
RestartSec=10
MemoryMax=100M

[Install]
WantedBy=default.target
